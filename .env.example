# Copy to .env and fill in real values. Never put real secrets in this file.

NODE_ENV=development
PORT=3000

# Main database: Turso (libSQL, SQLite-compatible)
# Remote: libsql://DBNAME-ORG.REGION.turso.io (needs a token)
# Local file (tests, offline): file:./data/local.db (no token)
TURSO_DATABASE_URL=libsql://DBNAME-ORG.REGION.turso.io
TURSO_AUTH_TOKEN=

# Secrets (32+ chars each, keep them different). Generate each with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRET=
OTP_SECRET=

# Access token lifetime, then how long the refresh token works after that.
# A login lasts the sum: 15 + 1425 minutes = 24 hours.
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_MINUTES=1425

# Email verification code rules. Change and restart, no code edit needed.
OTP_TTL_MINUTES=10
OTP_RESEND_SECONDS=60
OTP_MAX_ATTEMPTS=5

# Rate limits (in-memory, per server instance). Window is shared.
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_REGISTER_MAX=5

# Reverse proxies in front of the app. 0 locally, 1 on Render/Heroku.
TRUST_PROXY=0

# Public address of the web app. Emails get a "Log in" button when set.
# APP_URL=https://app.example.com

# Frontend origin allowed to call the API with cookies (optional).
# CORS_ORIGIN=http://localhost:5173

# Where the refresh cookie is sent. Behind an /api proxy: /api/auth/refresh
REFRESH_COOKIE_PATH=/auth/refresh

# Verification email. MAIL_FROM is the sender. SMTP_* is how it is delivered.
# MAIL_FROM=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=

# Optional. Both must be set together, then `npm run seed:admin` creates the admin.
# ADMIN_EMAIL=admin@slotbook.local
# ADMIN_PASSWORD=change-this-admin-password

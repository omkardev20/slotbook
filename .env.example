# Copy to .env and fill in real values. Never put real secrets in this file.

NODE_ENV=development
PORT=3000

# Main database: Turso (libSQL, SQLite-compatible)
# Remote: libsql://DBNAME-ORG.REGION.turso.io (needs a token)
# Local file (tests, offline): file:./data/local.db (no token)
TURSO_DATABASE_URL=libsql://DBNAME-ORG.REGION.turso.io
TURSO_AUTH_TOKEN=

# Signs session cookies. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Verification email. MAIL_FROM is the sender. SMTP_* is how it is delivered.
# MAIL_FROM=you@example.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=

# Optional. Both must be set together, then `npm run seed:admin` creates the admin.
# ADMIN_EMAIL=admin@slotbook.local
# ADMIN_PASSWORD=change-this-admin-password
